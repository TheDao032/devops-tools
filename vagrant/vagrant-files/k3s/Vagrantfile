# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# k3s HA lab on QEMU (vagrant-qemu provider) — 5 VMs:
#   k3s-lb        .10   external etcd (single-node datastore) + HAProxy (TCP LB :6443)
#   k3s-server-1  .11   k3s server  (control-plane, datastore=external etcd)
#   k3s-server-2  .12   k3s server  (control-plane, datastore=external etcd)
#   k3s-agent-1   .21   k3s agent   (worker)
#   k3s-agent-2   .22   k3s agent   (worker)
#
# vagrant-qemu has NO private_network support, so inter-VM networking is a 2nd NIC
# on a QEMU socket-multicast L2 segment (in-guest setup: roles/k3s-etcd/network).

require 'yaml'

cfg = YAML.load_file(File.join(__dir__, 'config.yaml'))

# ── arch / accelerator resolution (parameterized: "both") ────────────────────
def norm_arch(a)
  case a.to_s.downcase
  when 'arm64', 'aarch64' then 'aarch64'
  when 'x86_64', 'amd64'  then 'x86_64'
  else a.to_s
  end
end

host_arch  = norm_arch(`uname -m`.strip)
is_darwin  = (RbConfig::CONFIG['host_os'] =~ /darwin/)
guest_arch = norm_arch(ENV['K3S_ARCH'] || cfg['arch'] || host_arch)
# distro selects which row of the boxes[distro][arch] matrix to use. Env wins so
# you can flip distro/arch without editing config.yaml: DISTRO=ubuntu K3S_ARCH=x86_64
distro     = (ENV['DISTRO'] || cfg['distro'] || 'ubuntu').to_s.downcase

# native virt when guest==host, else slow emulation (tcg)
accel = (guest_arch == host_arch) ? (is_darwin ? 'hvf' : 'kvm') : 'tcg'

machine  = (guest_arch == 'aarch64') ? "virt,accel=#{accel},highmem=on" : "q35,accel=#{accel}"
cpu      = (accel == 'tcg') ? (guest_arch == 'aarch64' ? 'cortex-a72' : 'max') : 'host'
deb_arch = (guest_arch == 'aarch64') ? 'arm64' : 'amd64'
qemu_dir = is_darwin ? '/opt/homebrew/share/qemu' : '/usr/share/qemu'

# boxes[distro][arch] = { name:, version: } — adding a distro/arch cell is DATA, not code.
box_entry = ((cfg['boxes'] || {})[distro] || {})[guest_arch] || {}
box       = box_entry['name']
box_ver   = box_entry['version']
raise "config.yaml: no box for distro='#{distro}' arch='#{guest_arch}' " \
      "— set boxes.#{distro}.#{guest_arch}.name (bake the box first if it doesn't exist)" \
      if box.nil? || box.to_s.empty?

if accel == 'tcg'
  warn "[k3s-qemu] WARNING: guest #{guest_arch} != host #{host_arch} → TCG emulation (slow). " \
       "Run this arch on a matching host for KVM/HVF acceleration."
end

SUBNET  = cfg['network']['subnet']
MCAST   = cfg['network']['mcast']
NET_DEV = 'virtio-net-pci'  # NOT the plugin default 'virtio-net-device' (mmio → NIC named eth0,
                            # breaks predictable naming + the box's netplan match)

NODES = [
  { name: 'k3s-lb',       role: 'lb',     octet: 10, res: cfg['nodes']['lb']     },
  { name: 'k3s-server-1', role: 'server', octet: 11, res: cfg['nodes']['server'] },
  { name: 'k3s-server-2', role: 'server', octet: 12, res: cfg['nodes']['server'] },
  { name: 'k3s-agent-1',  role: 'agent',  octet: 21, res: cfg['nodes']['agent']  },
  { name: 'k3s-agent-2',  role: 'agent',  octet: 22, res: cfg['nodes']['agent']  },
  # agent-3 (.23): 3rd worker so Vault's 3 replicas (hard hostname anti-affinity) have 3 distinct
  # schedulable nodes once both servers are tainted, + capacity for the FitMate services. MUST stay
  # LAST in NODES — the Ansible play only triggers on NODES.last, so `vagrant up k3s-agent-3` runs it.
  { name: 'k3s-agent-3',  role: 'agent',  octet: 23, res: cfg['nodes']['agent']  },
]

Vagrant.configure('2') do |config|
  config.vm.box           = box
  config.vm.box_version   = box_ver unless box_ver.nil? || box_ver.to_s.empty?
  config.vm.synced_folder '.', '/vagrant', disabled: true   # vagrant-qemu has no virtfs share
  config.vm.boot_timeout  = 600
  # The packer-baked boxes (ubuntu + archlinux) authorize ONLY the bake key
  # (packer/keys/packer_ed25519) in the `packer` user's authorized_keys — NOT
  # vagrant's insecure key. So point ssh at the bake key and DON'T insert/rotate
  # (insert_key=false). The insecure key is a fallback for any box that ships it.
  config.ssh.insert_key       = false
  config.ssh.private_key_path = [
    File.expand_path('../../../packer/keys/packer_ed25519', __dir__),
    '~/.vagrant.d/insecure_private_key',
  ]

  NODES.each do |node|
    config.vm.define node[:name] do |m|
      m.vm.hostname = node[:name]
      node_ip  = "#{SUBNET}.#{node[:octet]}"
      node_mac = "52:54:00:ab:cd:#{format('%02d', node[:octet])}"  # distinct from QEMU's default 52:54:00:12:34:56

      m.vm.provider 'qemu' do |qe|
        qe.arch            = guest_arch
        qe.machine         = machine
        qe.cpu             = cpu
        qe.smp             = node[:res]['cpus']
        qe.memory          = node[:res]['memory']
        # Deterministic, unique host SSH port per VM. vagrant-qemu defaults ALL VMs
        # to 50022 and its auto-correct races/fails under parallel `vagrant up`.
        qe.ssh_port        = 50000 + node[:octet]   # lb=50010, s1/s2=50011/12, a1/a2=50021/22
        qe.net_device      = NET_DEV
        qe.qemu_dir        = qemu_dir
        qe.firmware_format = 'raw' if guest_arch == 'aarch64'

        # 2nd NIC → shared cluster L2 segment. QEMU sockets can't carry broadcast/ARP
        # between VMs on macOS, so there we route qemu through socket_vmnet (vmnet.framework);
        # on Linux, socket-multicast works natively.
        if is_darwin
          qe.qemu_bin = File.join(__dir__, 'bin', 'qemu-socketvmnet.sh')  # wraps qemu with socket_vmnet_client
          qe.extra_qemu_args = %W[
            -netdev socket,id=net1,fd=3
            -device #{NET_DEV},netdev=net1,mac=#{node_mac}
          ]
        else
          qe.extra_qemu_args = %W[
            -netdev socket,id=net1,mcast=#{MCAST}
            -device #{NET_DEV},netdev=net1,mac=#{node_mac}
          ]
        end
      end

      # NOTE: cluster-NIC rename + static IP + /etc/hosts is no longer a per-VM shell
      # provisioner — it's the roles/k3s-etcd/network Ansible role (distro-agnostic via
      # os_family facts), which runs first in the play below. cluster_mac is handed to it
      # as a host_var so it can find the 2nd NIC regardless of distro NIC-naming.

      # Provision k3s via the Ansible roles (roles/k3s-etcd/*). Runs ONCE, on the
      # last VM, against ALL hosts — so cross-host group vars (etcd/infra/server
      # IPs) resolve in a single play. Requires `ansible` on the host.
      # NOTE: partial `vagrant up <one-vm>` will NOT trigger this; bring up all
      # VMs (`vagrant up`), or run the playbook manually via inventories/local/k3s/qemu.
      if node[:name] == NODES.last[:name]
        m.vm.provision 'k3s', type: 'ansible' do |a|
          a.playbook           = ENV['PLAYBOOK'] || '../../../ansible/playbooks/k3s-etcd-playbooks/site.yml'
          a.compatibility_mode = '2.0'
          a.limit              = 'all'
          a.groups = {
            'etcd'   => NODES.select { |n| n[:role] == 'lb' }.map { |n| n[:name] },
            'infra'  => NODES.select { |n| n[:role] == 'lb' }.map { |n| n[:name] },
            'server' => NODES.select { |n| n[:role] == 'server' }.map { |n| n[:name] },
            'agent'  => NODES.select { |n| n[:role] == 'agent' }.map { |n| n[:name] },
          }
          # Each node's cluster-LAN IP + 2nd-NIC MAC → consumed by the network role
          # (find/rename the NIC) and etcd/HAProxy/flannel (bind to cluster_ip).
          a.host_vars = NODES.map { |n| [n[:name], {
            'cluster_ip'  => "#{SUBNET}.#{n[:octet]}",
            'cluster_mac' => "52:54:00:ab:cd:#{format('%02d', n[:octet])}",
          }] }.to_h
          # config.yaml stays the single source of truth for versions/token.
          pg = cfg['postgres'] || {}
          a.extra_vars = {
            'k3s_version'            => cfg['k3s_version'],
            'etcd_version'           => cfg['etcd_version'],
            'k3s_token'              => cfg['cluster_token'],
            'cluster_iface'          => 'k3scl0',
            'etcd_client_port'       => 2379,
            'api_port'               => 6443,
            'load_balancer_port'     => 6443,
            'k3s_disable_components' => cfg['k3s_disable'],
            # Appended to `k3s server` after --disable (server-register.sh EXTRA_ARGS). Taints the
            # control-plane nodes so app workloads only land on agents. Only the server role consumes it.
            'k3s_server_extra_args' => cfg['k3s_server_taint'] || '',
            # PostgreSQL on the lb node (postgresql play, hosts: infra). mode=single -> one
            # bare-metal instance; mode=citus -> dockerized Citus cluster (citus-docker role).
            'pg_enabled'             => pg.fetch('enabled', false),
            'pg_mode'                => pg.fetch('mode', 'single'),
            'psql_version'           => pg['version'],
            'pg_app_db'              => pg['db'],
            'pg_app_user'            => pg['user'],
            'pg_app_password'        => pg['password'],
            'pg_listen_addresses'    => pg['listen'],
            # citus mode: worker container hostnames (docker DNS) — worker1..workerN.
            'citus_workers'          => (1..(pg.fetch('workers', 2).to_i)).map { |i| "worker#{i}" },
            # pg_hba trust CIDRs (template vars): the cluster LAN + k3s pod/service CIDRs so
            # both other nodes and in-cluster pods can reach Postgres on the lb.
            'server_cidr_range'         => "#{SUBNET}.0/24",
            'docker_network_cidr_range' => '10.42.0.0/16', # k3s default pod CIDR
            'docker_default_cidr_range' => '10.43.0.0/16', # k3s default service CIDR
          }
        end

        # Activate Vault on the HOST after the cluster is up. vault-activate.sh inspects the
        # cluster and does the right thing for EVERY lifecycle:
        #   • Vault not deployed yet (fresh destroy+up) → graceful no-op
        #   • fresh/uninitialized Vault                 → operator init (rotating any stale
        #                                                 keystore aside) + unseal
        #   • already-initialized Vault (halt->up)      → unseal only
        # We call the script via `run: { path: ... }` (NOT an inline heredoc): a multi-line
        # host-side inline trigger is split on whitespace and Vagrant tries to exec the first
        # token ("if") as a binary — hence the "executable 'if' not found" error. A path-run
        # executes the script through its shebang, and the script guards every edge itself.
        m.trigger.after :up do |t|
          t.name = 'vault-activate'
          t.run  = { path: File.join(__dir__, 'vault-activate.sh') }
        end
      end
    end
  end
end
