# base.env — configuration for the Arch Linux ARM (ALARM) STAGE-1 bootstrap.
#
# Sourced by scripts/rootfs-bootstrap/bootstrap-base.sh. Shell syntax (NOT HCL): stage 1
# is a plain bootstrap script, not a Packer build, because ALARM ships a rootfs
# tarball with no installer ISO for Packer to drive. (Stage 2 IS Packer and uses
# variables/nthedao/archlinux-arm64.pkrvars.hcl — see the runbook.)
#
# Everything here is overridable from the environment, e.g.:
#   ALARM_TARBALL_URL=... ./scripts/rootfs-bootstrap/bootstrap-base.sh

# ── Arch Linux ARM aarch64 rootfs ───────────────────────────────────────────
# "latest" is a rolling snapshot; the bake's first `pacman -Syu` pulls it fully
# current, so pinning here buys little. Integrity is verified against the sibling
# .md5 that ALARM publishes next to the tarball (fetched at bake time, not pinned
# in git — the rolling file's hash changes on every upstream sync).
ALARM_TARBALL_URL="${ALARM_TARBALL_URL:-http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz}"
ALARM_TARBALL_MD5_URL="${ALARM_TARBALL_MD5_URL:-${ALARM_TARBALL_URL}.md5}"

# ── Throwaway builder VM (Ubuntu arm64 cloud image) ─────────────────────────
# We do NOT install Ubuntu — the cloud image is a ready qcow2 that boots in
# seconds under hvf. It is the aarch64 Linux host we need to lay the ALARM
# rootfs onto a real block device and chroot in to install a bootloader (macOS
# can't do ext4/loop/chroot). An ephemeral overlay is used so the downloaded
# cloud image is never mutated between runs.
UBUNTU_CLOUDIMG_URL="${UBUNTU_CLOUDIMG_URL:-https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-arm64.img}"

# ── Target base image geometry ──────────────────────────────────────────────
BASE_SLUG="${BASE_SLUG:-archlinux-arm64}"          # output/base/<slug>/... + qcow2 name prefix
IMAGE_NAME_PREFIX="${IMAGE_NAME_PREFIX:-archlinux-arm64-base}"
TARGET_DISK_SIZE="${TARGET_DISK_SIZE:-20G}"         # virtual size of the baked base qcow2
ESP_SIZE_MIB="${ESP_SIZE_MIB:-512}"                 # EFI System Partition size (passed into the builder)

# ── SSH contract (matches the Ubuntu base bake) ─────────────────────────────
# The public half of keys/packer_ed25519 is injected into BOTH the builder (so
# this host script can drive it) AND the baked image's ~packer/authorized_keys
# (so Packer stage 2 can SSH in). Regenerate the keypair → re-bake the base.
SSH_USERNAME="${SSH_USERNAME:-packer}"

# ── Builder VM sizing / networking ──────────────────────────────────────────
BUILD_CPUS="${BUILD_CPUS:-4}"
BUILD_MEMORY_MB="${BUILD_MEMORY_MB:-4096}"
SSH_HOSTFWD_PORT="${SSH_HOSTFWD_PORT:-2222}"        # host port forwarded to builder :22
BUILDER_BOOT_TIMEOUT="${BUILDER_BOOT_TIMEOUT:-180}" # seconds to wait for builder SSH

# ── Host EFI firmware (Apple Silicon Homebrew qemu) ─────────────────────────
QEMU_EFI_CODE="${QEMU_EFI_CODE:-/opt/homebrew/share/qemu/edk2-aarch64-code.fd}"
QEMU_EFI_VARS="${QEMU_EFI_VARS:-/opt/homebrew/share/qemu/edk2-arm-vars.fd}"
