#---------------------------------------------------------------------
# Managed by Ansible (k3s-etcd/haproxy). TCP load-balancer for the k3s
# kube-apiserver across all `server` group hosts. No keepalived — single LB.
#---------------------------------------------------------------------
global
    log /dev/log local0
    maxconn 4096
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    timeout connect 10s
    timeout client  60m
    timeout server  60m

frontend k3s_api
    bind {{ haproxy_api_bind_ip }}:{{ haproxy_api_bind_port }}
    default_backend k3s_servers

backend k3s_servers
    # L7 health check against kube-apiserver /readyz over TLS. A plain `tcp-check` only confirms the
    # port is OPEN — a hung-but-listening API server (e.g. an OOM-wedged node) still passes it, so
    # HAProxy kept round-robining onto the dead server-2 → ~50% flapping. httpchk drops a backend whose
    # API isn't RESPONDING. NOTE: this apiserver requires auth on /readyz, so an UNAUTHENTICATED check
    # (no client cert) gets 401 — which still proves the API is alive (a hung one returns nothing). So
    # we expect 401, NOT 200 (expecting 200 marks every server down → VIP dead). Still mode tcp for the
    # proxied data path.
    option httpchk GET /readyz
    http-check expect status 401
    balance roundrobin
    default-server inter 5s fall 3 rise 2 check check-ssl verify none
{% for host in groups['server'] %}
    server {{ host }} {{ hostvars[host]['cluster_ip'] }}:{{ haproxy_backend_port }} check
{% endfor %}
